PORT=3000
# Set a unique initial password (12+ characters); otherwise generated to data/.initial_admin_password.txt
ADMIN_PASSWORD=
ADMIN_RESET_TOKEN=
WEBSITE_SYNC_URL=
WEBSITE_ADMIN_PASSWORD=
# Full HTTPS URL of this academy, used by external website course links
ACADEMY_PUBLIC_URL=https://v79academy.v79sl.com
# Set to 1 only when running behind your trusted reverse proxy
TRUST_PROXY=0
GEMINI_API_KEY=
# Stripe remains disabled until its checkout/webhook integration is configured.

# Shared HMAC secret used only for signed read-only V79 Hub service calls (32+ chars).
V79_PLATFORM_SHARED_SECRET=


# Phase 2 V79 Hub Academy event publisher.
V79_HUB_EVENT_URL=http://v79-hub:3040/api/platform/events
V79_HUB_EVENT_SECRET=
